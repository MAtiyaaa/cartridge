{
  "name": "cartridge",
  "productName": "Cartridge",
  "version": "0.7.0",
  "description": "Controller-first RomM client for SteamOS, Bazzite and Android",
  "main": "electron/main.js",
  "author": "abdu2304",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build && vite build --mode remote",
    "start": "vite build && vite build --mode remote && electron .",
    "dist": "vite build && vite build --mode remote && electron-builder --linux AppImage --x64 --publish never",
    "release": "vite build && vite build --mode remote && electron-builder --linux AppImage --x64 --publish always",
    "build:android": "node scripts/build-android.mjs",
    "apk": "node scripts/build-android.mjs && cd android && ./gradlew assembleRelease"
  },
  "build": {
    "appId": "io.github.abdu2304.cartridge",
    "productName": "Cartridge",
    "files": [
      "dist/**",
      "remote-dist/**",
      "electron/**",
      "build/icon.png",
      "build/syslogos/**",
      "package.json",
      "steam-art/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Cartridge-x86_64.AppImage",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Cartridge-x86_64.AppImage"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdu2304",
        "repo": "cartridge",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseName": "Cartridge 0.7.0 · Phone Remote",
      "releaseNotesFile": "RELEASE_NOTES.md"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "electron-updater": "^6.8.9",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.9",
    "@vitejs/plugin-vue": "6.0.9",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.9/capacitor-nodejs.tgz",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "vite": "8.3.1"
  },
  "desktopName": "cartridge.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdu2304/cartridge.git"
  },
  "homepage": "https://github.com/abdu2304/cartridge"
}
